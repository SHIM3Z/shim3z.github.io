---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Experience from "../components/Experience.astro";
import Education from "../components/Education.astro";
import Projects from "../components/Projects.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Paolo Siancas - Portfolio"
  description="Ingeniero de Sistemas fusionando Arquitectura de Software con Inteligencia Artificial."
>
  <!-- FONDO ANIMADO -->
  <div class="fixed inset-0 -z-10 overflow-hidden pointer-events-none">
    <div
      class="absolute top-[-10%] left-[20%] w-[30%] h-[30%] rounded-full bg-blue-900/20 blur-[120px] animate-pulse"
    >
    </div>
    <div
      class="absolute bottom-[10%] right-[10%] w-[20%] h-[20%] rounded-full bg-purple-900/20 blur-[100px] animate-pulse delay-1000"
    >
    </div>
    <div
      class="absolute inset-0 opacity-[0.03] bg-[url('https://grainy-gradients.vercel.app/noise.svg')]"
    >
    </div>
  </div>

  <Header />

  <main class="max-w-5xl mx-auto px-6 pt-40 pb-20">
    <Hero />
    <Experience />
    <Education />
    <Projects />

    <!-- CTA DOCS -->
    <section
      class="relative overflow-hidden rounded-[2.5rem] bg-linear-to-b from-slate-900 to-black border border-white/10 p-8 md:p-20 text-center"
    >
      <div
        class="absolute top-0 right-0 w-125 h-125 bg-blue-600/20 rounded-full blur-[120px] pointer-events-none mix-blend-screen"
      >
      </div>
      <div class="relative z-10 max-w-3xl mx-auto">
        <span
          class="inline-block p-4 rounded-2xl bg-blue-500/10 mb-6 border border-blue-500/20 text-blue-400"
        >
          <!-- FileText Icon -->
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="32"
            height="32"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path
              d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"
            ></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" x2="8" y1="13" y2="13"></line>
            <line x1="16" x2="8" y1="17" y2="17"></line>
            <line x1="10" x2="8" y1="9" y2="9"></line>
          </svg>
        </span>
        <h2 class="text-4xl font-bold text-white mb-6">
          Centro de Documentación
        </h2>
        <p class="text-slate-400 text-lg mb-8">
          ¿Quieres ver cómo funciona todo esto por dentro? He preparado guías
          técnicas detalladas.
        </p>
        <a
          href="/docs"
          class="inline-block px-8 py-4 rounded-full bg-white text-slate-900 font-bold hover:bg-blue-50 transition-all shadow-xl hover:-translate-y-1"
        >
          Ir al Hub de Documentación
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.5;
    }
  }

  .animate-pulse {
    animation: pulse 4s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  .delay-1000 {
    animation-delay: 1s;
  }
</style>
