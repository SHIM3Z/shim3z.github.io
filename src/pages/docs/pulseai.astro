---
import Layout from "../../layouts/Layout.astro";

const tableOfContents = [
  { id: "introduccion", label: "Introducción", active: true },
  { id: "arquitectura", label: "Arquitectura", active: false },
  { id: "instalacion", label: "Instalación", active: false },
  { id: "modelo-ia", label: "Modelo de IA", active: false },
  { id: "api-endpoints", label: "API Endpoints", active: false },
];
---

<Layout
  title="PulseAI Docs - Paolo Siancas"
  description="Documentación técnica del sistema de diagnóstico médico asistido por IA"
>
  <div class="min-h-screen bg-[#050505] text-slate-300 font-sans pb-20">
    <!-- NAV DE RETORNO -->
    <nav
      class="sticky top-0 z-50 bg-[#050505]/80 backdrop-blur-md border-b border-white/5 px-6 py-4 flex justify-between items-center"
    >
      <div class="flex items-center gap-4">
        <a
          href="/docs"
          class="p-2 rounded-lg hover:bg-white/10 transition-colors"
        >
          <!-- ArrowLeft Icon -->
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="m12 19-7-7 7-7"></path>
            <path d="M19 12H5"></path>
          </svg>
        </a>
        <span class="font-bold text-white text-lg">PulseAI Docs</span>
      </div>
      <div class="flex gap-4 text-sm font-medium">
        <span class="hidden md:block text-slate-400">v1.2.0</span>
        <a
          href="https://github.com/SHIM3Z"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 text-blue-400 hover:text-blue-300"
        >
          <!-- Github Icon -->
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path
              d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"
            ></path>
            <path d="M9 18c-4.51 2-5-2-7-2"></path>
          </svg>
          Repo
        </a>
      </div>
    </nav>

    <div class="flex max-w-7xl mx-auto mt-8">
      <!-- SIDEBAR (Índice) - Hidden on Mobile -->
      <aside
        class="hidden lg:block w-64 shrink-0 px-6 sticky top-24 h-[calc(100vh-6rem)] overflow-y-auto border-r border-white/5"
      >
        <h4 class="font-bold text-white mb-4 text-sm uppercase tracking-wider">
          Contenido
        </h4>
        <ul class="space-y-3 text-sm border-l border-white/10">
          {
            tableOfContents.map((item) => (
              <li>
                <a
                  href={`#${item.id}`}
                  class={`block pl-4 border-l transition-all ${
                    item.active
                      ? "border-blue-500 text-blue-400 font-medium"
                      : "border-transparent text-slate-400 hover:text-white hover:border-slate-600"
                  }`}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </aside>

      <!-- CONTENIDO PRINCIPAL (MARKDOWN SIMULADO) -->
      <main class="flex-1 px-6 md:px-12 max-w-4xl">
        <div class="mb-10 pb-10 border-b border-white/5">
          <h1
            id="introduccion"
            class="text-4xl md:text-5xl font-bold text-white mb-6"
          >
            PulseAI: Diagnóstico Asistido
          </h1>
          <p class="text-xl text-slate-400 leading-relaxed">
            PulseAI es un sistema de soporte a la decisión clínica que utiliza
            redes neuronales convolucionales (CNN) para detectar anomalías en
            electrocardiogramas (ECG) y frotis sanguíneos.
          </p>
          <div class="flex flex-wrap gap-4 mt-6">
            <span
              class="px-3 py-1 rounded bg-blue-500/10 text-blue-400 text-xs font-bold border border-blue-500/20"
              >Angular 17</span
            >
            <span
              class="px-3 py-1 rounded bg-yellow-500/10 text-yellow-400 text-xs font-bold border border-yellow-500/20"
              >Python FastAPI</span
            >
            <span
              class="px-3 py-1 rounded bg-purple-500/10 text-purple-400 text-xs font-bold border border-purple-500/20"
              >TensorFlow</span
            >
          </div>
        </div>

        <div class="prose prose-invert max-w-none">
          <!-- SECCIÓN ARQUITECTURA -->
          <h2
            id="arquitectura"
            class="text-2xl font-bold text-white mb-4 mt-12"
          >
            1. Arquitectura del Sistema
          </h2>
          <p class="mb-6 leading-relaxed text-slate-300">
            El sistema sigue una arquitectura de microservicios contenerizados.
            El frontend en Angular se comunica con un API Gateway que distribuye
            la carga entre el servicio de autenticación y el servicio de
            inferencia de IA.
          </p>
          <div
            class="bg-slate-900 rounded-xl p-6 border border-white/10 mb-8 font-mono text-sm text-blue-300 overflow-x-auto"
          >
            User Browser → Angular App → Nginx (Gateway) → FastAPI (Model
            Inference) → PostgreSQL
          </div>

          <h3 class="text-xl font-semibold text-white mb-3 mt-8">
            Componentes Principales
          </h3>
          <ul class="space-y-2 text-slate-300 mb-8">
            <li class="flex items-start gap-3">
              <span class="text-blue-500 mt-1">•</span>
              <span
                ><strong class="text-white">Frontend (Angular 17):</strong> Interfaz
                de usuario con componentes standalone y signals para reactividad.</span
              >
            </li>
            <li class="flex items-start gap-3">
              <span class="text-blue-500 mt-1">•</span>
              <span
                ><strong class="text-white">API Gateway (Nginx):</strong> Balanceo
                de carga y proxy reverso para microservicios.</span
              >
            </li>
            <li class="flex items-start gap-3">
              <span class="text-blue-500 mt-1">•</span>
              <span
                ><strong class="text-white">Servicio de Inferencia:</strong> FastAPI
                con modelo TensorFlow para predicciones en tiempo real.</span
              >
            </li>
            <li class="flex items-start gap-3">
              <span class="text-blue-500 mt-1">•</span>
              <span
                ><strong class="text-white">Base de Datos:</strong> PostgreSQL para
                almacenamiento de historial y usuarios.</span
              >
            </li>
          </ul>

          <!-- SECCIÓN INSTALACIÓN -->
          <h2 id="instalacion" class="text-2xl font-bold text-white mb-4 mt-12">
            2. Instalación Local
          </h2>
          <p class="mb-4 text-slate-300">
            Para levantar el entorno de desarrollo, asegúrate de tener Docker
            instalado.
          </p>

          <h3 class="text-xl font-semibold text-white mb-3 mt-6">
            Requisitos Previos
          </h3>
          <ul class="space-y-2 text-slate-300 mb-6">
            <li class="flex items-center gap-3">
              <span class="text-green-500">✓</span>
              Docker Desktop 4.0+
            </li>
            <li class="flex items-center gap-3">
              <span class="text-green-500">✓</span>
              Node.js 18+ (para desarrollo frontend)
            </li>
            <li class="flex items-center gap-3">
              <span class="text-green-500">✓</span>
              Python 3.10+ (para desarrollo backend)
            </li>
            <li class="flex items-center gap-3">
              <span class="text-green-500">✓</span>
              Git
            </li>
          </ul>

          <div
            class="bg-[#0d1117] rounded-xl p-4 border border-slate-800 overflow-x-auto mb-8"
          >
            <pre
              class="text-sm font-mono"><code><span class="text-slate-500"># Clonar el repositorio</span>
<span class="text-purple-400">git clone</span> <span class="text-slate-300">https://github.com/shim3z/pulse-ai.git</span>

<span class="text-slate-500"># Entrar al directorio</span>
<span class="text-purple-400">cd</span> <span class="text-slate-300">pulse-ai</span>

<span class="text-slate-500"># Levantar servicios</span>
<span class="text-purple-400">docker-compose</span> <span class="text-slate-300">up --build</span></code></pre>
          </div>

          <!-- SECCIÓN MODELO IA -->
          <h2 id="modelo-ia" class="text-2xl font-bold text-white mb-4 mt-12">
            3. Modelo de Inteligencia Artificial
          </h2>
          <p class="mb-6 leading-relaxed text-slate-300">
            El núcleo del sistema utiliza una Red Neuronal Convolucional (CNN)
            entrenada con el dataset MIT-BIH Arrhythmia Database para detección
            de arritmias cardíacas.
          </p>

          <div
            class="bg-linear-to-r from-blue-500/10 to-purple-500/10 rounded-xl p-6 border border-blue-500/20 mb-8"
          >
            <h4 class="text-white font-bold mb-4 flex items-center gap-2">
              <!-- Cpu Icon -->
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="text-blue-400"
              >
                <rect width="16" height="16" x="4" y="4" rx="2"></rect>
                <rect width="6" height="6" x="9" y="9" rx="1"></rect>
                <path d="M15 2v2"></path>
                <path d="M15 20v2"></path>
                <path d="M2 15h2"></path>
                <path d="M2 9h2"></path>
                <path d="M20 15h2"></path>
                <path d="M20 9h2"></path>
                <path d="M9 2v2"></path>
                <path d="M9 20v2"></path>
              </svg>
              Métricas del Modelo
            </h4>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
              <div class="text-center">
                <div class="text-2xl font-bold text-white">97.2%</div>
                <div class="text-xs text-slate-400 uppercase tracking-wide">
                  Accuracy
                </div>
              </div>
              <div class="text-center">
                <div class="text-2xl font-bold text-white">96.8%</div>
                <div class="text-xs text-slate-400 uppercase tracking-wide">
                  Precision
                </div>
              </div>
              <div class="text-center">
                <div class="text-2xl font-bold text-white">95.4%</div>
                <div class="text-xs text-slate-400 uppercase tracking-wide">
                  Recall
                </div>
              </div>
              <div class="text-center">
                <div class="text-2xl font-bold text-white">96.1%</div>
                <div class="text-xs text-slate-400 uppercase tracking-wide">
                  F1-Score
                </div>
              </div>
            </div>
          </div>

          <h3 class="text-xl font-semibold text-white mb-3">
            Arquitectura de la Red
          </h3>
          <div
            class="bg-[#0d1117] rounded-xl p-4 border border-slate-800 overflow-x-auto mb-8"
          >
            <pre
              class="text-sm font-mono"><code><span class="text-purple-400">model</span> = <span class="text-blue-400">Sequential</span>([
    <span class="text-blue-400">Conv1D</span>(<span class="text-yellow-400">64</span>, <span class="text-yellow-400">3</span>, activation=<span class="text-green-400">'relu'</span>, input_shape=(187, 1)),
    <span class="text-blue-400">MaxPooling1D</span>(<span class="text-yellow-400">2</span>),
    <span class="text-blue-400">Conv1D</span>(<span class="text-yellow-400">128</span>, <span class="text-yellow-400">3</span>, activation=<span class="text-green-400">'relu'</span>),
    <span class="text-blue-400">MaxPooling1D</span>(<span class="text-yellow-400">2</span>),
    <span class="text-blue-400">Flatten</span>(),
    <span class="text-blue-400">Dense</span>(<span class="text-yellow-400">128</span>, activation=<span class="text-green-400">'relu'</span>),
    <span class="text-blue-400">Dropout</span>(<span class="text-yellow-400">0.5</span>),
    <span class="text-blue-400">Dense</span>(<span class="text-yellow-400">5</span>, activation=<span class="text-green-400">'softmax'</span>)
])</code></pre>
          </div>

          <!-- SECCIÓN API ENDPOINTS -->
          <h2
            id="api-endpoints"
            class="text-2xl font-bold text-white mb-4 mt-12"
          >
            4. API Endpoints
          </h2>
          <p class="mb-6 leading-relaxed text-slate-300">
            La API REST está documentada con OpenAPI/Swagger y expone los
            siguientes endpoints principales:
          </p>

          <div class="space-y-4 mb-8">
            <!-- Endpoint 1 -->
            <div
              class="bg-slate-900/50 rounded-xl p-4 border border-white/5 hover:border-green-500/30 transition-colors"
            >
              <div class="flex items-center gap-3 mb-2">
                <span
                  class="px-2 py-1 rounded text-xs font-bold bg-green-500/20 text-green-400 border border-green-500/30"
                  >POST</span
                >
                <code class="text-white font-mono text-sm"
                  >/api/v1/predict/ecg</code
                >
              </div>
              <p class="text-slate-400 text-sm">
                Envía datos de ECG para análisis y obtiene predicción de
                arritmia.
              </p>
            </div>

            <!-- Endpoint 2 -->
            <div
              class="bg-slate-900/50 rounded-xl p-4 border border-white/5 hover:border-green-500/30 transition-colors"
            >
              <div class="flex items-center gap-3 mb-2">
                <span
                  class="px-2 py-1 rounded text-xs font-bold bg-green-500/20 text-green-400 border border-green-500/30"
                  >POST</span
                >
                <code class="text-white font-mono text-sm"
                  >/api/v1/predict/blood</code
                >
              </div>
              <p class="text-slate-400 text-sm">
                Envía imagen de frotis sanguíneo para clasificación celular.
              </p>
            </div>

            <!-- Endpoint 3 -->
            <div
              class="bg-slate-900/50 rounded-xl p-4 border border-white/5 hover:border-blue-500/30 transition-colors"
            >
              <div class="flex items-center gap-3 mb-2">
                <span
                  class="px-2 py-1 rounded text-xs font-bold bg-blue-500/20 text-blue-400 border border-blue-500/30"
                  >GET</span
                >
                <code class="text-white font-mono text-sm"
                  >/api/v1/history/{"{user_id}"}</code
                >
              </div>
              <p class="text-slate-400 text-sm">
                Obtiene historial de análisis de un usuario específico.
              </p>
            </div>

            <!-- Endpoint 4 -->
            <div
              class="bg-slate-900/50 rounded-xl p-4 border border-white/5 hover:border-blue-500/30 transition-colors"
            >
              <div class="flex items-center gap-3 mb-2">
                <span
                  class="px-2 py-1 rounded text-xs font-bold bg-blue-500/20 text-blue-400 border border-blue-500/30"
                  >GET</span
                >
                <code class="text-white font-mono text-sm">/api/v1/health</code>
              </div>
              <p class="text-slate-400 text-sm">
                Verifica el estado de salud del servicio y conexiones.
              </p>
            </div>
          </div>

          <!-- EJEMPLO DE REQUEST -->
          <h3 class="text-xl font-semibold text-white mb-3">
            Ejemplo de Request
          </h3>
          <div
            class="bg-[#0d1117] rounded-xl p-4 border border-slate-800 overflow-x-auto mb-8"
          >
            <pre
              class="text-sm font-mono"><code><span class="text-purple-400">curl</span> -X POST <span class="text-green-400">"https://api.pulseai.dev/v1/predict/ecg"</span> \
  -H <span class="text-green-400">"Authorization: Bearer {"{token}"}"</span> \
  -H <span class="text-green-400">"Content-Type: application/json"</span> \
  -d <span class="text-yellow-400">'{"{"}"ecg_data": [0.12, 0.45, ...], "sampling_rate": 360{"}"}'</span></code></pre>
          </div>

          <!-- FOOTER DE DOCS -->
          <div
            class="mt-16 pt-8 border-t border-white/5 flex flex-col md:flex-row justify-between items-center gap-4"
          >
            <p class="text-slate-500 text-sm">
              Última actualización: Diciembre 2025
            </p>
            <div class="flex gap-4">
              <a
                href="https://github.com/SHIM3Z"
                target="_blank"
                rel="noopener noreferrer"
                class="text-slate-400 hover:text-white transition-colors text-sm flex items-center gap-2"
              >
                <!-- Github Icon -->
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path
                    d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"
                  ></path>
                  <path d="M9 18c-4.51 2-5-2-7-2"></path>
                </svg>
                Ver en GitHub
              </a>
              <a
                href="/docs"
                class="text-slate-400 hover:text-white transition-colors text-sm"
              >
                ← Volver al Hub
              </a>
            </div>
          </div>
        </div>
      </main>

      <!-- ESPACIO DERECHO (Para balance visual) -->
      <div class="hidden xl:block w-64 shrink-0"></div>
    </div>
  </div>
</Layout>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const sidebarLinks = document.querySelectorAll("aside a");
    const sections = document.querySelectorAll("h1[id], h2[id]");

    function updateActiveSection() {
      let currentSection = "";

      sections.forEach((section) => {
        const rect = section.getBoundingClientRect();
        if (rect.top <= 150) {
          currentSection = section.id;
        }
      });

      sidebarLinks.forEach((link) => {
        const href = link.getAttribute("href");
        if (href === `#${currentSection}`) {
          link.classList.remove("border-transparent", "text-slate-400");
          link.classList.add("border-blue-500", "text-blue-400", "font-medium");
        } else {
          link.classList.remove(
            "border-blue-500",
            "text-blue-400",
            "font-medium"
          );
          link.classList.add("border-transparent", "text-slate-400");
        }
      });
    }

    window.addEventListener("scroll", updateActiveSection, { passive: true });
    updateActiveSection();
  });
</script>
