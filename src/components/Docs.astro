---
const docs = [
  { title: "PulseAI - Guía de Instalación", category: "Medical", link: "#" },
  { title: "API Reference v2.0", category: "Backend", link: "#" },
  {
    title: "Configuración de Docker Containers",
    category: "DevOps",
    link: "#",
  },
  { title: "Estructura de Red Neuronal CNN", category: "AI/ML", link: "#" },
];
---

<section
  id="docs"
  class="relative overflow-hidden rounded-[2.5rem] bg-linear-to-b from-slate-900 to-black border border-white/10 p-8 md:p-20 text-center md:text-left scroll-mt-24"
>
  <!-- Fondo estético -->
  <div
    class="absolute top-0 right-0 w-125 h-125 bg-blue-600/20 rounded-full blur-[120px] pointer-events-none mix-blend-screen"
  >
  </div>

  <div class="relative z-10 max-w-5xl mx-auto">
    <div class="flex flex-col md:flex-row gap-12 items-center">
      <div class="flex-1 text-center md:text-left">
        <span
          class="inline-block p-4 rounded-2xl bg-blue-500/10 mb-6 border border-blue-500/20 text-blue-400 shadow-[0_0_30px_rgba(59,130,246,0.2)]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="32"
            height="32"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path
              d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"
            ></path><polyline points="14 2 14 8 20 8"></polyline><line
              x1="16"
              x2="8"
              y1="13"
              y2="13"></line><line x1="16" x2="8" y1="17" y2="17"></line><line
              x1="10"
              x2="8"
              y1="9"
              y2="9"></line></svg
          >
        </span>
        <h2 class="text-4xl md:text-5xl font-bold text-white mb-6">
          Centro de <br />Documentación
        </h2>
        <p class="text-slate-400 text-lg mb-8 leading-relaxed">
          Porque un buen código no sirve de nada si nadie sabe usarlo. Accede a
          manuales técnicos y guías detalladas.
        </p>

        <div class="relative group max-w-md mx-auto md:mx-0">
          <div
            class="absolute inset-y-0 left-4 flex items-center pointer-events-none"
          >
            <svg
              class="text-slate-500 group-focus-within:text-blue-400 transition-colors"
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"
              ></path></svg
            >
          </div>
          <input
            type="text"
            id="doc-search"
            placeholder="Buscar en la documentación..."
            class="w-full pl-12 pr-4 py-4 bg-slate-950/80 border border-slate-800 rounded-2xl text-white placeholder-slate-600 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all shadow-xl"
          />
        </div>
      </div>

      <div class="flex-1 w-full">
        <div
          id="docs-list"
          class="grid gap-3 max-h-100 overflow-y-auto pr-2 custom-scrollbar"
        >
          {
            docs.map((doc) => (
              <a
                href={doc.link}
                data-title={doc.title.toLowerCase()}
                data-category={doc.category.toLowerCase()}
                class="doc-item flex items-center gap-4 p-4 rounded-2xl bg-white/5 border border-white/5 hover:bg-slate-800 hover:border-blue-500/50 transition-all group cursor-pointer"
              >
                <div class="h-10 w-10 rounded-xl bg-slate-900 flex items-center justify-center text-slate-400 group-hover:text-blue-400 group-hover:scale-110 transition-all border border-white/5">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <>
                      <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z" />
                      <polyline points="14 2 14 8 20 8" />
                      <line x1="16" x2="8" y1="13" y2="13" />
                      <line x1="16" x2="8" y1="17" y2="17" />
                      <line x1="10" x2="8" y1="9" y2="9" />
                    </>
                  </svg>
                </div>
                <div class="text-left flex-1">
                  <h4 class="font-bold text-slate-200 group-hover:text-white transition-colors">
                    {doc.title}
                  </h4>
                  <p class="text-xs text-slate-500 uppercase tracking-wide mt-0.5">
                    {doc.category}
                  </p>
                </div>
                <div class="h-8 w-8 rounded-full border border-white/10 flex items-center justify-center group-hover:bg-blue-600 group-hover:border-blue-600 transition-all">
                  <svg
                    class="text-slate-500 group-hover:text-white"
                    xmlns="http://www.w3.org/2000/svg"
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="m9 18 6-6-6-6" />
                  </svg>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .custom-scrollbar::-webkit-scrollbar {
    width: 4px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.02);
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.1);
    border-radius: 10px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.2);
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const searchInput = document.getElementById(
      "doc-search"
    ) as HTMLInputElement;
    const docItems = document.querySelectorAll(".doc-item");

    if (searchInput) {
      searchInput.addEventListener("input", (e) => {
        const searchTerm = (e.target as HTMLInputElement).value.toLowerCase();

        docItems.forEach((item) => {
          const title = item.getAttribute("data-title") || "";
          const category = item.getAttribute("data-category") || "";

          if (title.includes(searchTerm) || category.includes(searchTerm)) {
            (item as HTMLElement).style.display = "";
          } else {
            (item as HTMLElement).style.display = "none";
          }
        });
      });
    }
  });
</script>
