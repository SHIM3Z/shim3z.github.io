---

const experience = [
  // {
  //   year: '10/2025 - 11/2025',
  //   role: 'Full Stack Developer & AI Engineer',
  //   company: 'Freelance / Proyectos Propios',
  //   desc: 'Desarrollo de arquitectura de software escalable. Implementación de modelos de Deep Learning para diagnóstico médico (PulseAI) y optimización de procesos mediante bots de automatización.',
  //   tech: ['Angular', 'Python', 'TensorFlow', 'Docker']
  // },
  {
    year: '10/2025 - 11/2025',
    role: 'Desarrollador Frontend',
    company: 'EsSalud',
    desc: 'Desarrollé los módulos de gestión de filiaciones y programación de citas médicas para el sistema de asegurados de EsSalud.',
    tech: ['Angular 19', 'TypeScript', 'Docker']
  },
  {
    year: '06/2025 - 08/2025',
    role: 'Desarrollador Frontend',
    company: 'EsSalud',
    desc: 'Desarrollé la interfaz frontend del sistema de Salud Inteligente de EsSalud (ESSI) utilizando Angular 19, optimizando la experiencia de usuario y el diseño mediante arquitectura de componentes moderna. Refactoricé y modernicé librerías legacy para asegurar compatibilidad, mejorar la accesibilidad y el diseño visual, aplicando rigurosamente principios SOLID en TypeScript para garantizar un código mantenible y escalable.',
    tech: ['Angular 19', 'TypeScript', 'Docker']
  },
  {
    year: '2023 - 2024',
    role: 'Desarrollador Frontend Junior',
    company: 'Tech Solutions Inc.',
    desc: 'Colaboración en el desarrollo de dashboards administrativos. Migración de componentes legacy a Angular 17 y optimización de rendimiento web.',
    tech: ['Angular', 'RxJS', 'SASS']
  }
];
---

<section id="experience" class="mb-40 scroll-mt-24">
  <div class="flex items-center gap-4 mb-16">
    <div class="h-px flex-1 bg-linear-to-r from-transparent via-slate-800 to-transparent"></div>
    <h2 class="text-3xl font-bold text-white text-center">Trayectoria Profesional</h2>
    <div class="h-px flex-1 bg-linear-to-r from-transparent via-slate-800 to-transparent"></div>
  </div>

  <div class="relative space-y-8 max-w-3xl mx-auto">
    <!-- Línea conectora central -->
    <div class="absolute left-8 top-0 bottom-0 w-px bg-slate-800 md:left-1/2 md:-ml-px"></div>

    {experience.map((exp, idx) => (
      <div class={`relative flex flex-col md:flex-row items-center ${idx % 2 === 0 ? 'md:flex-row-reverse' : ''}`}>
        
        <!-- Dot Central -->
        <div class="absolute left-8 -translate-x-1/2 md:left-1/2 w-4 h-4 rounded-full bg-slate-950 border-2 border-blue-500 shadow-[0_0_10px_rgba(59,130,246,0.5)] z-10"></div>

        <!-- Contenido (Tarjeta) -->
        <div class="ml-20 md:ml-0 md:w-1/2 md:px-12 w-full">
          <div class="group relative p-6 rounded-2xl bg-slate-900/50 border border-white/5 hover:border-blue-500/30 hover:bg-slate-900/80 transition-all duration-300 hover:-translate-y-1 shadow-xl">
            <!-- Glow effect on hover -->
            <div class="absolute inset-0 bg-blue-500/5 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity"></div>
            
            <div class="relative z-10">
              <span class="inline-block px-3 py-1 mb-3 rounded-full bg-blue-500/10 text-blue-400 text-xs font-bold border border-blue-500/20">
                {exp.year}
              </span>
              <h3 class="text-xl font-bold text-white mb-1 group-hover:text-blue-400 transition-colors">{exp.role}</h3>
              <p class="text-sm font-medium text-slate-400 mb-4 flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/><rect width="20" height="14" x="2" y="6" rx="2"/></svg>
                {exp.company}
              </p>
              <p class="text-slate-400 text-sm leading-relaxed mb-4">
                {exp.desc}
              </p>
              <div class="flex flex-wrap gap-2">
                {exp.tech.map((t) => (
                  <span class="text-[10px] uppercase tracking-wider font-semibold text-slate-500">#{t}</span>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>
